EVDS_API_KEY=

# Enable only on the canonical https://devrem.co production deployment.
# Preview, staging and local environments should leave this false/unset.
SEO_ALLOW_INDEXING=false
# Optional Search Console verification token (without the google-site-verification= prefix).
GOOGLE_SITE_VERIFICATION=

# Optional emergency/bootstrap admin. Prefer Firebase Authentication below.
# Set as server-only deployment secrets; remove after Firebase admin access works.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Existing Devrem Firebase project
FIREBASE_PROJECT_ID=devrem-d985b
FIREBASE_STORAGE_BUCKET=devrem-d985b.firebasestorage.app
FIREBASE_CLIENT_EMAIL=
# Use escaped newlines when the platform expects a single-line secret.
FIREBASE_PRIVATE_KEY=
# Firebase Authentication REST sign-in. This key is public by design, but keep
# deployment configuration centralized.
FIREBASE_WEB_API_KEY=
# Community writes use Firebase Anonymous Authentication via this web API key.
# Enable Anonymous sign-in in Firebase Console → Authentication → Sign-in method.
# The service account also needs firebaseauth.users.get/update for the Admin
# Users module. Admin roles live in the adminRole custom claim.

# Local migration/debug alternative only; do not use a short-lived token in production.
FIREBASE_ACCESS_TOKEN=

# E2E write tests are blocked for devrem-d985b regardless of this value. Use
# only with an isolated non-production Firebase project.
ALLOW_E2E_MUTATIONS=false
